# DeepSeek is the real model backend. Use mock explicitly for offline tests.
MODEL_MODE=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
OLLAMA_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen3:4b
# Run Ollama and pull qwen3-embedding:4b before starting the application.
EMBEDDING_MODE=ollama
EMBEDDING_MODEL=qwen3-embedding:4b
DATABASE_PATH=data/app.sqlite3
# Required standalone Qdrant service; start with docker compose up -d.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=knowledge
QDRANT_API_KEY=
MODEL_TIMEOUT_SECONDS=180
RETRIEVAL_MIN_SCORE=0.5

# local | stdio | http. HTTP MCP server: python -m src.mcp_server --http
TOOL_TRANSPORT=local
MCP_URL=http://127.0.0.1:8011/mcp

# Separate audio service using /audio/transcriptions and /audio/speech.
# DeepSeek chat credentials are NOT sent to this service.
SPEECH_BASE_URL=
SPEECH_API_KEY=
ASR_MODEL=
TTS_MODEL=
