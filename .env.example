# DeepSeek is the real model backend. Use mock explicitly for offline tests.
MODEL_MODE=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
OLLAMA_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen3:4b
# hash is a lexical test baseline, not a semantic embedding model.
EMBEDDING_MODE=hash
EMBEDDING_MODEL=qwen3-embedding:0.6b
DATABASE_PATH=data/app.sqlite3
MODEL_TIMEOUT_SECONDS=60
RETRIEVAL_MIN_SCORE=0.12

# local | stdio | http. HTTP MCP server: python -m src.mcp_server --http
TOOL_TRANSPORT=local
MCP_URL=http://127.0.0.1:8011/mcp

# Separate audio service using /audio/transcriptions and /audio/speech.
# DeepSeek chat credentials are NOT sent to this service.
SPEECH_BASE_URL=
SPEECH_API_KEY=
ASR_MODEL=
TTS_MODEL=
